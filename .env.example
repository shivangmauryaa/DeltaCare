# Twilio API-key authentication
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=replace_with_rotated_secret
TWILIO_SMS_FROM=+15551234567
TWILIO_WHATSAPP_FROM=+14155238886

# Email delivery (optional)
APP_BASE_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DeltaCare <care@example.edu>
SMTP_REPLY_TO=care@example.edu
SMTP_MAX_RETRIES=2
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES=100
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Browser push (optional overrides; stable local keys are generated automatically)
VAPID_SUBJECT=mailto:care@example.edu
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Storage, malware scanning, and automatic local backups
UPLOAD_PROVIDER=inline
CLAMAV_HOST=
AUTO_BACKUP_HOURS=24
BACKUP_RETENTION_DAYS=30

# Optional university OpenID Connect capability indicator
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
